"""GPT advisor. Read-only role: scores setups (1-10) and writes daily summaries.

The model never decides to execute. The trading loop only uses the numeric score
as one filter alongside deterministic rules.
"""
import json
import logging
from openai import OpenAI

import config
from signals import Signal

log = logging.getLogger(__name__)

_client: OpenAI | None = None


def _get_client() -> OpenAI:
    global _client
    if _client is None:
        if not config.OPENAI_API_KEY:
            raise RuntimeError("Missing OPENAI_API_KEY in .env")
        _client = OpenAI(api_key=config.OPENAI_API_KEY)
    return _client


SCORE_SYSTEM_PROMPT = """You are a risk-aware trading analyst reviewing forex setups.
You will be given a candidate EUR/USD trade signal with pattern, RSI, MACD, ATR, and recent price action.

Return STRICT JSON with this exact shape:
{
  "score": <integer 1-10>,
  "reasoning": "<2-3 sentences explaining the score>",
  "red_flags": ["<flag1>", "<flag2>"]
}

Scoring guide:
- 1-3: weak setup, conflicting signals, low conviction
- 4-6: marginal, only trade if other factors strong
- 7-8: clean confluence, take the trade
- 9-10: rare, very strong confluence

Be conservative. The trader is a beginner on a practice account. Better to skip than force trades.
Output JSON only, no markdown fences."""


def score_setup(signal: Signal, recent_closes: list[float]) -> dict:
    """Ask GPT to rate the setup. Returns dict with score, reasoning, red_flags."""
    if signal.direction == "none":
        return {"score": 0, "reasoning": "no direction", "red_flags": []}

    user_msg = json.dumps({
        "instrument": "EUR_USD",
        "timeframe": "H1",
        "proposed_direction": signal.direction,
        "pattern": signal.pattern,
        "rsi": round(signal.rsi, 2),
        "macd_state": signal.macd_state,
        "atr": round(signal.atr, 5),
        "last_close": signal.last_close,
        "last_high": signal.last_high,
        "last_low": signal.last_low,
        "recent_20_closes": [round(c, 5) for c in recent_closes[-20:]],
        "notes": signal.notes,
    })

    try:
        client = _get_client()
        resp = client.chat.completions.create(
            model=config.OPENAI_MODEL,
            messages=[
                {"role": "system", "content": SCORE_SYSTEM_PROMPT},
                {"role": "user", "content": user_msg},
            ],
            temperature=0.2,
            response_format={"type": "json_object"},
        )
        raw = resp.choices[0].message.content
        data = json.loads(raw)
        score = int(data.get("score", 0))
        return {
            "score": max(0, min(10, score)),
            "reasoning": str(data.get("reasoning", ""))[:500],
            "red_flags": data.get("red_flags", [])[:5],
        }
    except Exception as e:
        log.exception("AI scoring failed: %s", e)
        # On failure, return neutral score so deterministic rules can still decide
        return {"score": 5, "reasoning": f"ai_error: {e}", "red_flags": []}


def write_daily_summary(trades_today: list[dict], account: dict) -> str:
    """Generate a plain-English end-of-day summary."""
    try:
        client = _get_client()
        resp = client.chat.completions.create(
            model=config.OPENAI_MODEL,
            messages=[
                {"role": "system", "content": "You are a concise forex trading journal writer. Write a short EOD summary in plain English. 4-6 sentences. No financial advice."},
                {"role": "user", "content": json.dumps({"account": account, "trades": trades_today})},
            ],
            temperature=0.4,
        )
        return resp.choices[0].message.content.strip()
    except Exception as e:
        log.exception("Daily summary failed: %s", e)
        return f"Summary generation failed: {e}"
